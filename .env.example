# --- Required ---
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=

# --- RAG (Voyage AI + Qdrant) ---
# Without VOYAGE_API_KEY / when Qdrant is unreachable the bot still works, but
# all facts go into the prompt as-is (fallback), with no vector search.
VOYAGE_API_KEY=
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- Models (change the version without touching code) ---
# Concrete IDs for the opus/sonnet/haiku aliases. Pricing in code is keyed by
# alias, so bumping a version here doesn't break cost accounting.
MODEL_OPUS=claude-opus-4-8
MODEL_SONNET=claude-sonnet-4-6
MODEL_HAIKU=claude-haiku-4-5

# --- Backups ---
# Passphrase for the periodic encrypted archive (scripts/backup_facts.sh).
# Keep it OUT of the repo and store it somewhere safe — without it the
# encrypted backups cannot be restored.
BACKUP_PASSPHRASE=

# --- Optional ---
# CLAUDE_MODEL=claude-opus-4-8
# MAX_HISTORY=25
# MAX_TOKENS=32000
# ALLOWED_USERS=123456789,987654321
# SYSTEM_PROMPT=
