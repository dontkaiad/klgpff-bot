# --- Required ---
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=

# --- RAG (Voyage AI + Postgres/pgvector) ---
# Without VOYAGE_API_KEY / when Postgres is unreachable the bot still works, but
# all facts go into the prompt as-is (fallback), with no vector search.
VOYAGE_API_KEY=
# Own database + role with the `vector` extension (created by a DB admin).
# Host is the Postgres container name on the shared docker network.
DATABASE_URL=postgresql://klgpff:CHANGE_ME@nexus-arcana-db:5432/klgpff

# --- Models (change the version without touching code) ---
# Concrete IDs for the opus/sonnet/haiku aliases. Pricing in code is keyed by
# alias, so bumping a version here doesn't break cost accounting.
MODEL_OPUS=claude-opus-5-5
MODEL_SONNET=claude-sonnet-5-5
MODEL_HAIKU=claude-haiku-5-5

# --- Telegram logging (optional) ---
# Startup/error events to a Telegram thread. When any of the three is missing
# the logger degrades to a no-op (one warning on import), the bot runs normally.
TG_LOG_BOT_TOKEN=
TG_LOG_CHAT_ID=
TG_LOG_THREAD_KLGPFF=

# --- Backups ---
# Passphrase for the periodic encrypted archive (scripts/backup_facts.sh).
# Keep it OUT of the repo and store it somewhere safe — without it the
# encrypted backups cannot be restored.
BACKUP_PASSPHRASE=

# --- Optional ---
# CLAUDE_MODEL=claude-opus-5-5
# MAX_HISTORY=8        # пар в истории до обрезки
# HISTORY_KEEP=4       # сколько пар оставить после обрезки (режем пачкой — ради кеша)
# CACHE_TTL=1h         # 5m | 1h
# RAG_TOP_K=30         # фактов на один запрос поиска
# RAG_MAX_FACTS=50     # потолок фактов в промпте
# FACTS_FULL_LIMIT=0   # >0: пока фактов не больше — отдавать все без поиска
# MAX_TOKENS=32000
# ALLOWED_USERS=123456789,987654321
# SYSTEM_PROMPT=
