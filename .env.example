# Обязательные
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=

# Поиск по фактам (Voyage AI и Postgres с pgvector)
# Без VOYAGE_API_KEY или при недоступной БД бот работает, но все факты идут в
# промпт целиком, без векторного поиска.
VOYAGE_API_KEY=
# Отдельная база и роль с расширением vector (расширение создаёт админ БД).
# Хост это имя контейнера Postgres в общей docker-сети.
DATABASE_URL=postgresql://klgpff:CHANGE_ME@nexus-arcana-db:5432/klgpff
# Пока фактов не больше этого числа, в промпт идут все факты и поиск не
# используется. 0 значит поиск всегда.
FACTS_FULL_LIMIT=150

# Модели
# Конкретные ID для алиасов opus, sonnet, haiku. Цены в коде привязаны к алиасу,
# поэтому смена версии здесь не ломает учёт расходов.
MODEL_OPUS=claude-opus-5-5
MODEL_SONNET=claude-sonnet-5-5
MODEL_HAIKU=claude-haiku-5-5

# Логи в Telegram (необязательно)
# События запуска и ошибки уходят в тему Telegram-группы. Если не задана любая из
# трёх переменных, логгер ничего не отправляет (одно предупреждение при импорте),
# бот работает как обычно.
TG_LOG_BOT_TOKEN=
TG_LOG_CHAT_ID=
TG_LOG_THREAD_KLGPFF=

# Бэкапы
# Парольная фраза для периодического шифрованного архива (scripts/backup_facts.sh).
# Хранить вне репозитория. Без неё архивы не восстановить.
BACKUP_PASSPHRASE=

# Необязательные (значения по умолчанию из кода)
# CLAUDE_MODEL=claude-opus-5-5   # модель для /regenerate, пока режим auto
# MAX_HISTORY=8                  # пар в истории до обрезки
# HISTORY_KEEP=4                 # сколько пар оставить после обрезки (режем пачкой, ради кеша)
# CACHE_TTL=1h                   # 5m или 1h
# RAG_TOP_K=30                   # фактов на один поисковый запрос
# RAG_MAX_FACTS=50               # потолок фактов из поиска
# MAX_TOKENS=32000               # max_tokens на ответ
# ALLOWED_USERS=123456789,987654321
# SYSTEM_PROMPT=
